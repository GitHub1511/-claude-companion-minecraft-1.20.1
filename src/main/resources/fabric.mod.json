{
	"schemaVersion": 1,
	"id": "claudecompanion",
	"version": "${version}",
	"name": "Claude Companion",
	"description": "Claude as an in-world companion you can talk to out loud. Walks, builds with any block, sees what you see, runs commands. Powered by the Claude API.",
	"authors": [
		"Shiv"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.claudecompanion.ClaudeCompanion"
		],
		"client": [
			"com.claudecompanion.client.ClaudeCompanionClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.14.21",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api-base": "*",
		"fabric-command-api-v2": "*",
		"fabric-message-api-v1": "*",
		"fabric-entity-events-v1": "*",
		"fabric-lifecycle-events-v1": "*",
		"fabric-events-interaction-v0": "*",
		"fabric-object-builder-api-v1": "*",
		"fabric-rendering-v1": "*",
		"fabric-key-binding-api-v1": "*",
		"fabric-networking-api-v1": "*"
	},
	"suggests": {
		"fabric-api": "*"
	}
}
